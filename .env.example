# --- LLM providers (add keys for whichever ones you'll use in the UI) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=
# Free tier — get a key at console.groq.com. Good model choices:
# llama-3.3-70b-versatile (best quality) or gemma2-9b-it (fastest)
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=
# Free tier — get a key at aistudio.google.com/apikey (Gemma models)
GOOGLE_MODEL=gemma-4-12b-it

OPENROUTER_API_KEY=
# One key, many models (GPT, DeepSeek, Gemini, Llama, etc). Free-tier models
# have ":free" suffix. Get a key at openrouter.ai/keys
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# --- Supabase (optional — only needed for Save/Load projects) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel (optional — only needed for the in-app "Deploy" button) ---
# Get a token from vercel.com/account/tokens
VERCEL_API_TOKEN=
# Only needed if your Vercel account is inside a team
VERCEL_TEAM_ID=
